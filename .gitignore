# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# scripts locais com chaves (nao subir para o github)
setup-stripe.js
ENVIAR-GITHUB.bat
push-github.ps1
FAZER-PUSH.bat
INSTALAR-SUPABASE.bat
CRIAR-PLANOS-STRIPE.bat
PUSH-ATUALIZACAO.bat
